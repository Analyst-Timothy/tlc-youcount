{
  "functions": {
    "api/portal.js": { "maxDuration": 30 }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://tlc-blush.vercel.app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/portal-api",
      "destination": "https://tlc-blush.vercel.app/api/portal"
    },
    {
      "source": "/influence-api",
      "destination": "https://tlc-blush.vercel.app/api/influence"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
